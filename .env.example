# ═══════════════════════════ ILOVA ═══════════════════════════
NODE_ENV=production
# ⚠️ 3000 — ESP32 proshivkasidagi manzil shu portga ishora qiladi
# (`http://host:3000/api/data`). O'zgartirsangiz, qurilmalarni ham
# qayta proshivka qilish kerak bo'ladi.
PORT=3000
API_PREFIX=api/v1

# ⚠️ Frontend QAYSI manzildan kelsa — AYNAN o'sha. Vergul bilan bir
# nechta bo'lishi mumkin. Oxirida `/` qo'yilsa MOS KELMAYDI va brauzer
# har so'rovni bloklaydi — server jurnalida esa xato KO'RINMAYDI.
# ⚠️ Frontend manzili. Vergul bilan bir nechta berish mumkin.
#    Ishlab chiqishda: http://localhost:5173
CORS_ORIGINS=https://issiqlik.yaxshihayot.uz

# ═══════════════════════════ POSTGRESQL ═══════════════════════
# ⚠️ Port 5442 — bu LOYIHANING O'Z klasteri (`npm run pg:start`), tizim
# klasteri (5432/5433) emas. Sabab: tizim klasteriga ulanish `sudo` yoki
# `postgres` rolining parolini talab qiladi, loyiha klasteri esa joriy
# foydalanuvchi nomidan ishlaydi va hech qanday maxsus huquq so'ramaydi.
# Ma'lumot `~/.local/share/issiqlik/pgdata` da doimiy saqlanadi.
#
# Tizim klasteriga o'tmoqchi bo'lsangiz: `DB_PORT=5432` qo'ying va
# rol/bazani qo'lda yarating (`sudo -u postgres psql`).
#
# ⚠️ `localhost` EMAS, `127.0.0.1`: ba'zi tizimlarda `localhost` avval
# IPv6 (::1) ga hal qilinadi, klaster esa faqat IPv4 ni tinglaydi.
DB_HOST=127.0.0.1
DB_PORT=5442
DB_USERNAME=issiqlik
DB_PASSWORD=<baza-paroli>
DB_NAME=issiqlik_db
DB_LOGGING=false
DB_SSL=false

# ═══════════════════════════ JWT ══════════════════════════════
# ⚠️ Prod'da ALBATTA almashtiring: openssl rand -hex 32
# Access va refresh sirlari BOSHQA-BOSHQA bo'lishi shart: bir xil
# bo'lsa, refresh tokenni access token o'rniga ishlatib bo'lardi.
# ⚠️⚠️ ISHLAB CHIQARISHDA ALBATTA O‘ZGARTIRING. Pastdagi qiymatlar
# O‘RIN EGALLOVCHI: ular bilan qoldirilsa, bu faylni o‘qigan HAR KIM
# administrator tokenini soxtalashtira oladi.
# Yaratish: openssl rand -base64 48
JWT_ACCESS_SECRET=<openssl-rand-base64-48>
JWT_ACCESS_TTL=30m
JWT_REFRESH_SECRET=<openssl-rand-base64-48>
JWT_REFRESH_TTL=30d

# ═══════════════════ BIRINCHI ADMINISTRATOR ═══════════════════
# ⚠️ FAQAT bazada birorta `super_admin` YO'Q bo'lganda o'qiladi.
# Mavjud hisobning paroli bu yerdan O'ZGARMAYDI — aks holda `.env` ni
# tahrirlay oladigan har kim istalgan hisobni egallab olardi.
# Parolni almashtirish uchun tizim ichidagi forma ishlatiladi.
ADMIN_LOGIN=<superadmin-login>
# ⚠️ Birinchi ishga tushishda SHU parol bilan superadmin yaratiladi.
# Haqiqiy parolni hech qachon bu faylga yozmang — u git‘ga tushadi.
ADMIN_PASSWORD=<superadmin-paroli>
ADMIN_FULL_NAME=Tizim administratori

# ═════════════════ KOTYOL HOLATI CHEGARALARI ══════════════════
# ⚠️ Bular faqat BOSHLANG'ICH qiymat. Haqiqiy chegara bazada
# (`system_settings`) va Sozlamalar sahifasidan o'zgartiriladi: qishda
# chegarani o'zgartirish uchun serverni to'xtatish kerak bo'lmasligi shart.
#
#   harorat ≥ 50           → faol ishlayotgan
#   40 ≤ harorat < 50      → o'rta ishlayotgan
#   20 ≤ harorat < 40      → ishlamayotgan
#   harorat < 20 yoki aloqa yo'q → o'chiq
BOILER_ACTIVE_MIN_C=50
BOILER_MEDIUM_MIN_C=40
BOILER_CRITICAL_MIN_C=20
# Signal kelmasa necha daqiqadan keyin «aloqa yo'q» deb hisoblanadi.
BOILER_OFFLINE_AFTER_MIN=15
# Hujjatdagi me'yoriy harorat — yangi kotyol uchun sukut qiymati.
BOILER_NORM_TEMPERATURE=60

# ═══════════════════════ TELEMETRIYA ══════════════════════════
TELEMETRY_MAX_PER_MINUTE=60
# O'lchovlar necha kun saqlanadi (keyin tungi cron tozalaydi).
TELEMETRY_RETENTION_DAYS=90

# ═══════════════════════ RATE LIMIT ═══════════════════════════
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# ───────────────────── ESP32 v2.0.0 va OTA ─────────────────────
# Umumiy qurilma tokeni — KO'CHISH DAVRI uchun, sukut bo'yicha BO'SH (o'chiq).
# Bo'sh bo'lsa, faqat shaxsiy tokenlar ishlaydi. To'ldirilsa, u faqat
# `devices.allow_shared_token = true` qilib belgilangan qurilmalarga ishlaydi.
# Kamida 24 belgi bo'lishi shart.
# Qurilmalar ko'radigan TASHQI manzil. OTA javobidagi yuklab olish havolasi
# shundan quriladi va proshivka uni qat'iy tekshiradi: https:// bo'lishi va
# domen proshivkadagi SERVER_HOST bilan AYNI bo'lishi SHART.
# Ishlab chiqarishda: https://<domen>
# ⚠️⚠️ BU MANZIL PROSHIVKADAGI SERVER_HOST BILAN AYNAN BIR XIL
#    BO‘LISHI SHART (firmware/include/config.h). Farq qilsa yoki
#    http:// bo‘lsa, qurilma yangilanishni RAD ETADI va tokenini
#    ham yubormaydi (net.cpp dagi isOwnServerUrl tekshiruvi).
#    Ishlab chiqishda: http://localhost:3000
PUBLIC_BASE_URL=https://issiqlik-api.yaxshihayot.uz

DEVICE_SHARED_TOKEN=

# Proshivka (.bin) fayllari papkasi — WEB ROOT'DAN TASHQARIDA turishi kerak.
# Ichida qurilma tokeni bo'lishi mumkin, shuning uchun hech qachon
# statik papkaga qo'yilmaydi.
FIRMWARE_DIR=./storage/firmware
# Bir vaqtda ko'pi bilan nechta qurilma proshivka yuklab olishi mumkin
# (1.9 MB × N — kanalni to'ldirib, telemetriyani ham to'xtatib qo'ymasligi uchun).
FIRMWARE_MAX_CONCURRENT=10
